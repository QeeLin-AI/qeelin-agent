# 复制为 .env（同目录），程序启动时自动读取；已存在的环境变量优先，不会被覆盖。

# ---- LLM（任何 OpenAI 兼容网关）----
# mock = 不调用模型，用内置规则引擎兜底，可完全离线跑通全流程
CRYPTOAGENT_LLM_PROVIDER=mock
# CRYPTOAGENT_LLM_PROVIDER=openai
CRYPTOAGENT_LLM_MODEL=deepseek-flash
CRYPTOAGENT_LLM_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxx

# ---- 币安 U 本位合约 ----
# 模拟盘（Demo Trading）与主网是两套独立 Key，互不回退
# 创建时只勾「允许合约交易」，不要勾「允许提现」，并尽量绑定出口 IP 白名单
# BINANCE_DEMO_API_KEY=
# BINANCE_DEMO_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ---- OKX 永续 ----
# OKX 的 Passphrase 是创建 API Key 时单独设置的，不是登录密码或资金密码
# OKX_DEMO_API_KEY=
# OKX_DEMO_API_SECRET=
# OKX_DEMO_PASSPHRASE=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=

# ---- Web 控制台访问令牌（留空则自动生成）----
# CRYPTOAGENT_WEB_TOKEN=

# ---- 重启后自动解锁（只允许假钱环境）----
# 格式 <exchange>:<env>，例如 binance:demo / okx:demo / binance:testnet；
# 不带交易所前缀时跟随当前活跃交易所。主网环境会被拒绝。
# CRYPTOAGENT_AUTO_ARM=binance:demo

# ---- 主网双闸门（两个都满足才允许真实资金下单）----
# 1) 取消下面这行的注释
# CRYPTOAGENT_I_UNDERSTAND_THE_RISK=yes
# 2) 在项目根目录建一个空文件 .cryptoagent_live_ack
