[Unit]
Description=crypto-agent 永续合约研究/交易控制台
Documentation=file:/opt/crypto-agent/README.md
After=network-online.target
Wants=network-online.target
# 崩溃重启限流。这两个键只认 [Unit]，写在 [Service] 里 systemd 会忽略并告警。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=cryptotrader
Group=cryptotrader
WorkingDirectory=/opt/crypto-agent
# 与页面「保存 Key」写的是同一个文件（config.update_dotenv 默认写项目根 .env），
# 否则页面上存进去的 Key 重启后就丢了。文件不存在时用 - 前缀不让服务启动失败。
EnvironmentFile=-/opt/crypto-agent/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# 包在 src/ 下，必须把 src 加进 PYTHONPATH（否则 No module named cryptoagent）
Environment=PYTHONPATH=/opt/crypto-agent/src
# 监听所有网卡，手机/外网可直接访问 http://<公网IP>:8000/?token=...
# serve() 在绑定非回环地址且没有 CRYPTOAGENT_WEB_TOKEN 时会直接拒绝启动，
# 不会出现「裸奔控制台」。只想本机访问（SSH 隧道）就把这里改回 127.0.0.1。
ExecStart=/opt/crypto-agent/.venv/bin/python -m cryptoagent web --host 0.0.0.0 --port 8000 --no-browser
Restart=always
RestartSec=5

# --- 加固 ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# config 也要可写：设置页保存参数会重写 config/default.json，
# 漏了它就会「页面报保存失败 / 参数改了不生效」。
# .env 加 - 前缀：文件还没创建时不能因此启动失败。
ReadWritePaths=-/opt/crypto-agent/.env /opt/crypto-agent/runs /opt/crypto-agent/data /opt/crypto-agent/factors_library /opt/crypto-agent/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# 实盘 Key 只在这个文件里，权限 600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cryptoagent

[Install]
WantedBy=multi-user.target
